<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>dev.openspec.cycle</string>
  <key>ProgramArguments</key>
  <array><string>/bin/bash</string><string>{{WORKSPACE_ROOT}}/bin/run_cycle.sh</string></array>
  <key>WorkingDirectory</key><string>{{WORKSPACE_ROOT}}</string>
  <key>StartInterval</key><integer>3600</integer>
  <key>RunAtLoad</key><false/>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>{{RUBY_BIN_DIR}}:/opt/homebrew/bin:/usr/local/bin:{{HOME}}/.local/bin:/usr/bin:/bin</string>
    <key>OPENSPEC_BASE_BRANCH</key><string>master</string>
    <key>OPENSPEC_WORKERS</key><string>2</string>
    <key>AGENT_ENGINE</key><string>claude</string>
    <!-- Optional phase overrides: fallback to AGENT_ENGINE when omitted -->
    <!-- <key>AGENT_ENGINE_PLAN</key><string>claude</string> -->
    <!-- <key>AGENT_ENGINE_BUILD</key><string>claude</string> -->
    <!-- <key>AGENT_ENGINE_CYCLE</key><string>claude</string> -->
  </dict>
  <key>StandardOutPath</key><string>{{WORKSPACE_ROOT}}/log/launchd-cycle.log</string>
  <key>StandardErrorPath</key><string>{{WORKSPACE_ROOT}}/log/launchd-cycle.log</string>
</dict>
</plist>
