<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>dev.openspec.merger</string>
  <key>ProgramArguments</key>
  <array><string>/usr/bin/env</string><string>ruby</string><string>bin/openspec_merger.rb</string><string>--watch</string><string>--interval</string><string>30</string></array>
  <key>WorkingDirectory</key><string>{{WORKSPACE_ROOT}}</string>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>60</integer>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>{{RUBY_BIN_DIR}}:/opt/homebrew/bin:/usr/local/bin:{{HOME}}/.local/bin:/usr/bin:/bin</string>
    <key>OPENSPEC_BASE_BRANCH</key><string>master</string>
  </dict>
  <key>StandardOutPath</key><string>{{WORKSPACE_ROOT}}/log/launchd-merger.log</string>
  <key>StandardErrorPath</key><string>{{WORKSPACE_ROOT}}/log/launchd-merger.log</string>
</dict>
</plist>
