#!/usr/bin/env bash
# ==============================================================================
# bin/openspec-kit - CLI entry point installed into ~/.local/bin/openspec-kit
# ==============================================================================
# Installed by:
#   curl -fsSL https://raw.githubusercontent.com/mayeco/openspec-kit/master/install.sh | sh
# which clones the deliverable repository into ~/.openspec-kit and writes the
# wrapper ~/.local/bin/openspec-kit:
#   #!/bin/sh
#   exec "$HOME/.openspec-kit/bin/openspec-kit" "$@"
#
# Commands:
#   openspec-kit init [<app-dir>] --agents LIST [--plan A --build A --cycle A] [--order ORDER] [--force]
#   openspec-kit update|upgrade [<app-dir>] [--agents LIST ...] [--force]
#   openspec-kit self-upgrade [<tag-or-branch>]
#   openspec-kit verify [<app-dir>]
#   openspec-kit cycle [--detach]
#   openspec-kit visual-qa begin | end | status | request "<what>" [--change <name>] | done <id> <verdict> ["<note>"] | enqueue-integrated
#   openspec-kit gates [--all] [--regression] [--base <ref>] [--repo <name>]
#   openspec-kit exec <repo> <command> [args...]
#   openspec-kit status
#   openspec-kit progress [--since 24h|90m|7d|<time>] [--json]
#   openspec-kit config show [<section>] [--json] | check [--json] | set <file>.<key> <value> [--dry-run]
#   openspec-kit setup status [--json] | add-repo <url> [--name <name>] [--branch <branch>] | repo <name> [--force]
#   openspec-kit proposals review | list | show <change> | approve <change> | reject <change> | rebase <base> | carry <checkout>
#   openspec-kit preflight [--services]
#   openspec-kit dispatch [--workers N] [--wait] [--dry-run] [--json]
#   openspec-kit merge [--watch [--interval SECONDS]]
#   openspec-kit sync [--publish]
#   openspec-kit completed-since <base-sha> [<head-ref>]
#   openspec-kit jev-report [--since <period>] [--gate <name>] [--json]
#   openspec-kit prompt-report [--since <period>] [--by prompt|memory] [--json]
#   openspec-kit prompts check | render <plan|build|cycle> [k=v ...] | version <plan|build|cycle>
#   openspec-kit memory status | fingerprint
#   openspec-kit agents engine <role> | list | order | permissions | in-use | extra-args <agent>
#   openspec-kit settings get <key>
#   openspec-kit portal [--port 4567] [--bind 127.0.0.1]
#   openspec-kit version
# Environment overrides (for tests or custom locations):
#   OPENSPEC_KIT_HOME     checkout of the release repository (default: ~/.openspec-kit)
#   OPENSPEC_KIT_BIN_DIR  directory on PATH for the wrapper (default: ~/.local/bin)
#   OPENSPEC_KIT_REPO     git remote URL (default: https://github.com/mayeco/openspec-kit.git)
set -euo pipefail

SELF_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
KIT_HOME="${OPENSPEC_KIT_HOME:-$HOME/.openspec-kit}"
BIN_DIR="${OPENSPEC_KIT_BIN_DIR:-$HOME/.local/bin}"
REPO_URL="${OPENSPEC_KIT_REPO:-https://github.com/mayeco/openspec-kit.git}"

# When run from a release checkout (such as ~/.openspec-kit/bin/openspec-kit),
# use that checkout; otherwise use $KIT_HOME for install, update and self-upgrade.
if [ -f "$SELF_ROOT/MANIFEST.json" ]; then
  RELEASE="$SELF_ROOT"
else
  RELEASE="$KIT_HOME"
fi

write_shim() { # <kit-home> <bin-dir>
  local home="$1" dir="$2" shim="$2/openspec-kit"
  mkdir -p "$dir"
  cat > "$shim" <<EOF
#!/bin/sh
exec "$home/bin/openspec-kit" "\$@"
EOF
  chmod +x "$shim"
}

cmd="${1:-}"
shift || true

case "$cmd" in
  init|install)
    if [ ! -f "$RELEASE/MANIFEST.json" ]; then
      echo "openspec-kit: no release found at $RELEASE (run 'openspec-kit self-upgrade' first)" >&2
      exit 2
    fi
    exec ruby "$RELEASE/bin/openspec_kit.rb" init "$@" --source "$RELEASE"
    ;;
  upgrade|update)
    if [ ! -f "$RELEASE/MANIFEST.json" ]; then
      echo "openspec-kit: no release found at $RELEASE (run 'openspec-kit self-upgrade' first)" >&2
      exit 2
    fi
    exec ruby "$RELEASE/bin/openspec_kit.rb" upgrade "$@" --source "$RELEASE"
    ;;
  self-upgrade|self-update)
    target_ref="${1:-}"
    if [ -d "$KIT_HOME/.git" ]; then
      git -C "$KIT_HOME" fetch --tags --prune --quiet origin
      if [ -n "$target_ref" ]; then
        git -C "$KIT_HOME" checkout --quiet "$target_ref"
        if git -C "$KIT_HOME" symbolic-ref -q HEAD >/dev/null 2>&1; then
          git -C "$KIT_HOME" merge --ff-only --quiet "origin/$target_ref" 2>/dev/null || true
        fi
      else
        branch="$(git -C "$KIT_HOME" symbolic-ref -q --short HEAD || true)"
        if [ -n "$branch" ]; then
          git -C "$KIT_HOME" merge --ff-only --quiet "origin/$branch"
        else
          latest="$(git -C "$KIT_HOME" tag -l 'v*' --sort=-v:refname | head -1)"
          git -C "$KIT_HOME" checkout --quiet "${latest:-origin/HEAD}"
        fi
      fi
    else
      rm -rf "$KIT_HOME"
      mkdir -p "$(dirname "$KIT_HOME")"
      if [ -n "$target_ref" ]; then
        git clone --quiet --branch "$target_ref" "$REPO_URL" "$KIT_HOME"
      else
        git clone --quiet "$REPO_URL" "$KIT_HOME"
      fi
    fi
    write_shim "$KIT_HOME" "$BIN_DIR"
    ver="$(ruby -rjson -e 'puts((JSON.parse(File.read(ARGV[0]))["version"] rescue "unknown"))' "$KIT_HOME/MANIFEST.json" 2>/dev/null || echo unknown)"
    echo "openspec-kit: $KIT_HOME is at v$ver ($BIN_DIR/openspec-kit)"
    ;;
  verify)
    exec ruby "$SELF_ROOT/bin/openspec_kit.rb" verify "$@"
    ;;
  cycle)
    exec bash "$SELF_ROOT/bin/run_cycle.sh" "$@"
    ;;
  visual-qa|visual_qa)
    case "${1:-}" in
      begin|end) exec bash "$SELF_ROOT/bin/visual_qa.sh" "$@" ;;
      *)         exec ruby "$SELF_ROOT/bin/visual_qa.rb" "$@" ;;
    esac
    ;;
  gates)
    exec bash "$SELF_ROOT/bin/run_gates.sh" "$@"
    ;;
  exec|repo-exec)
    exec bash "$SELF_ROOT/bin/repo_exec.sh" "$@"
    ;;
  status)
    exec bash "$SELF_ROOT/bin/cycle_status.sh" "$@"
    ;;
  progress)
    exec ruby "$SELF_ROOT/bin/cycle_progress.rb" "$@"
    ;;
  config)
    exec ruby "$SELF_ROOT/bin/kit_config.rb" "$@"
    ;;
  setup)
    exec ruby "$SELF_ROOT/bin/app_setup.rb" "$@"
    ;;
  proposals)
    exec ruby "$SELF_ROOT/bin/proposals.rb" "$@"
    ;;
  preflight|check-engines)
    exec bash "$SELF_ROOT/bin/check_ai_engines.sh" "$@"
    ;;
  dispatch)
    exec ruby "$SELF_ROOT/bin/openspec_dispatcher.rb" "$@"
    ;;
  merge)
    exec ruby "$SELF_ROOT/bin/openspec_merger.rb" "$@"
    ;;
  sync)
    exec bash "$SELF_ROOT/bin/sync_repos.sh" "$@"
    ;;
  completed-since)
    exec bash "$SELF_ROOT/bin/completed_since.sh" "$@"
    ;;
  jev-report)
    exec ruby "$SELF_ROOT/bin/jev_report.rb" "$@"
    ;;
  prompt-report)
    exec ruby "$SELF_ROOT/bin/prompt_report.rb" "$@"
    ;;
  prompts)
    exec ruby "$SELF_ROOT/bin/lib/prompts.rb" "$@"
    ;;
  memory)
    exec ruby "$SELF_ROOT/bin/lib/memory.rb" "$@"
    ;;
  agents)
    exec ruby "$SELF_ROOT/bin/lib/agents.rb" "$@"
    ;;
  settings)
    exec ruby "$SELF_ROOT/bin/lib/settings.rb" "$@"
    ;;
  agent-exec)
    exec bash "$SELF_ROOT/bin/agent_exec.sh" "$@"
    ;;
  jev-contract)
    exec bash "$SELF_ROOT/bin/jev_contract.sh" "$@"
    ;;
  cycle-prompt)
    exec ruby "$SELF_ROOT/bin/cycle_prompt.rb" "$@"
    ;;
  portal)
    exec ruby "$SELF_ROOT/bin/portal.rb" "$@"
    ;;
  version|-v|--version)
    ver="$(ruby -rjson -e 'puts((JSON.parse(File.read(ARGV[0]))["version"] rescue "unknown"))' "$RELEASE/MANIFEST.json" 2>/dev/null || echo unknown)"
    echo "openspec-kit v$ver ($RELEASE)"
    ;;
  *)
    sed -n '2,39p' "$0"
    exit 2
    ;;
esac
